                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "spec": {
                        "query": "import \"dict\"\n\nweatherMap = [\n    \"0\": \"☀️\",\n    \"1\": \"🌤️\",\n    \"2\": \"🌥️\",\n    \"3\": \"☁️\",\n    \"45\": \"🌫️\", \"48\": \"🌫️\",\n    \"51\": \"🌦️\", \"53\": \"🌦️\", \"55\": \"🌦️\",\n    \"56\": \"🥶\", \"57\": \"🥶\",\n    \"61\": \"🌧️\", \"63\": \"🌧️\", \"65\": \"🌧️\",\n    \"66\": \"🧊\", \"67\": \"🧊\",\n    \"71\": \"❄️\", \"73\": \"❄️\", \"75\": \"❄️\",\n    \"77\": \"🌨️\",\n    \"80\": \"🌦️\", \"81\": \"🌦️\", \"82\": \"🌦️\",\n    \"85\": \"🌨️\", \"86\": \"🌨️\",\n    \"95\": \"⛈️\",\n    \"96\": \"🌩️\", \"99\": \"🌩️\"\n]\n\nfrom(bucket: \"my-bucket\")\n  |> range(\n       start: 0,\n       stop: v.timeRangeStop,\n     )\n  |> filter(\n       fn: (r) =>\n       r[\"_measurement\"] == \"weather\" and\n       r[\"_field\"] == \"weather_code\"\n     )\n  |> aggregateWindow(\n       every: 4h,\n       fn: mode,\n       createEmpty: false\n     )\n  |> fill(\n       usePrevious: true\n     )\n  |> drop(\n       columns: [\n         \"_measurement\",\n         \"_field\",\n         \"_start\",\n         \"_stop\",\n         \"location_alias\",\n         \"latitude\",\n         \"longitude\",\n         \"timezone\",\n       ]\n     )\n  |> map(\n       fn: (r) => ({\n         r with\n         _value: dict.get(\n           dict: weatherMap,\n           key: string(v: int(v: r._value)),\n           default: \"❓\"\n         )\n       })\n     )\n  |> pivot(\n       rowKey: [\"_time\"],\n       columnKey: [\"location_name\"],\n       valueColumn: \"_value\"\n     )"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
