            "spec": {
              "limit": 100,
              "matchAny": false,
              "query": "from(bucket: \"my-bucket\")\n  |> range(\n       start: v.timeRangeStart,\n       stop: v.timeRangeStop\n     )\n  |> filter(\n       fn: (r) =>\n       r[\"_measurement\"] == \"internal_gather\" and\n       r[\"alias\"] == \"loc1_weather\" and\n       r[\"_field\"] == \"metrics_gathered\"\n     )\n  |> group()\n  |> difference()\n  |> filter(\n       fn: (r) =>\n       r[\"_value\"] > 0\n     )\n  |> tail (n: 1)",
              "tags": [],
              "type": "dashboard"
            }
          },
          "enable": true,
          "hide": false,
          "iconColor": "purple",
          "name": "Forecast",
